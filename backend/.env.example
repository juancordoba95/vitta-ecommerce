DB_URL=jdbc:mysql://localhost:3306/vitta_db
DB_USERNAME=vitta_app
DB_PASSWORD=
# "dev" loads sample catalog data (db/dev-data). Never use it in production.
SPRING_PROFILES_ACTIVE=dev
# Allowed CORS origin for the frontend.
FRONTEND_URL=http://localhost:3000
# HS256 signing secret, at least 32 bytes. Generate one with: openssl rand -base64 48
# Required outside the dev profile. In dev, leave these commented to use the dev defaults
# from application-dev.yaml (an empty value would override them).
# JWT_SECRET=
# Admin token lifetime (Spring Duration: 8h, 30m, ...). Default 8h.
# JWT_EXPIRATION=8h
# Initial admin, created on startup if it does not exist. If unset, no admin is created.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
