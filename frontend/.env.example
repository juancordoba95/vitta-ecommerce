# Backend base URL. Used by the browser (catalog, cart) and by the Next server (admin
# session, /api/session), so it must be reachable from both.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Store WhatsApp number that receives checkout orders, in international format without
# "+", spaces or dashes: 54 + 9 + area code without the leading 0 + number without 15.
# Example shape only (not a real number): 5491100000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
