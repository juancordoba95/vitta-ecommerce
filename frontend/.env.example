# Backend base URL, no trailing slash. SERVER-ONLY (no NEXT_PUBLIC_): the browser never
# calls the backend, it goes through this app's route handlers. Required in production:
# without it the server reports a clear error.
# Production example (Render): https://<service>.onrender.com
BACKEND_URL=http://localhost:8080

# Store WhatsApp number that receives checkout orders, in international format without
# "+", spaces or dashes: 54 + 9 + area code without the leading 0 + number without 15.
# Example shape only (not a real number): 5491100000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
